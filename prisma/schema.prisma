generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// ESTUDIOS
// ========================================

model Estudio {
  id            Int      @id @default(autoincrement())
  nombre        String
  telefono      String?
  email         String?
  direccion     String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarios              Usuario[]
  clientes              Cliente[]
  citas                 Cita[]
  tatuajes              Tatuaje[]
  pagos                 Pago[]
  gastos                Gasto[]
  inventarios           Inventario[]
  movimientosInventario MovimientoInventario[]
  fotos                 Foto[]
  suscripcion           Suscripcion?
  configuracion         ConfiguracionEstudio?
  horarios              HorarioEstudio[]
  bloqueos              BloqueoAgenda[]
  consentimientos       Consentimiento[]
  recordatorios         RecordatorioCita[]
}

// ========================================
// USUARIOS
// ========================================

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  email         String   @unique
  password      String
  rol           Rol      @default(TATUADOR)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  eliminadoEn   DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  citas                 Cita[]
  tatuajes              Tatuaje[]
  pagos                 Pago[]
  gastos                Gasto[]
  movimientosInventario MovimientoInventario[]
  bloqueos              BloqueoAgenda[]

  @@index([estudioId])
}

// ========================================
// CLIENTES
// ========================================

model Cliente {
  id            String   @id @default(uuid())
  nombre        String
  telefono      String
  email         String?
  instagram     String?
  direccion     String?
  alergias      String?
  enfermedades  String?
  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  eliminadoEn   DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  citas            Cita[]
  tatuajes         Tatuaje[]
  pagos            Pago[]
  fotos            Foto[]
  consentimientos  Consentimiento[]

  @@unique([estudioId, telefono])
  @@index([estudioId])
  @@index([telefono])
  @@index([estudioId, actualizadoEn])
}

// ========================================
// CITAS
// ========================================

model Cita {
  id            String     @id @default(uuid())
  fecha         DateTime
  duracion      Int        @default(120)
  motivo        String?
  notas         String?
  estado        EstadoCita @default(PENDIENTE)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt
  eliminadoEn   DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tatuajeId String?
  tatuaje   Tatuaje? @relation(fields: [tatuajeId], references: [id], onDelete: SetNull)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  consentimientos Consentimiento[]
  recordatorios   RecordatorioCita[]

  @@index([estudioId, fecha])
  @@index([clienteId])
  @@index([tatuajeId])
  @@index([estudioId, actualizadoEn])
}

// ========================================
// TATUAJES
// ========================================

model Tatuaje {
  id            String        @id @default(uuid())
  nombre        String
  descripcion   String?
  estilo        String?
  zona          String?
  precio        Decimal?      @db.Decimal(10, 2)
  anticipo      Decimal?      @db.Decimal(10, 2)
  estado        EstadoTatuaje @default(PENDIENTE)
  notas         String?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt
  eliminadoEn   DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  fotos                 Foto[]
  pagos                 Pago[]
  movimientosInventario MovimientoInventario[]
  citas                 Cita[]

  @@index([estudioId])
  @@index([clienteId])
  @@index([usuarioId])
  @@index([estudioId, actualizadoEn])
}

// ========================================
// PAGOS
// ========================================

model Pago {
  id            String     @id @default(uuid())
  monto         Decimal    @db.Decimal(10, 2)
  concepto      String?
  notas         String?
  metodo        MetodoPago
  fecha         DateTime   @default(now())
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt
  eliminadoEn   DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tatuajeId String?
  tatuaje   Tatuaje? @relation(fields: [tatuajeId], references: [id], onDelete: Cascade)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estudioId])
  @@index([estudioId, actualizadoEn])
}

// ========================================
// GASTOS
// ========================================

model Gasto {
  id            Int            @id @default(autoincrement())
  concepto      String
  descripcion   String?
  monto         Decimal        @db.Decimal(10, 2)
  fecha         DateTime       @default(now())
  categoria     CategoriaGasto
  notas         String?
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  eliminadoEn   DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estudioId, fecha])
}

// ========================================
// FOTOS
// ========================================

model Foto {
  id            String   @id @default(uuid())
  url           String
  descripcion   String?
  tipo          TipoFoto @default(TATUAJE)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  eliminadoEn   DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tatuajeId String?
  tatuaje   Tatuaje? @relation(fields: [tatuajeId], references: [id], onDelete: Cascade)

  @@index([estudioId])
  @@index([clienteId])
  @@index([tatuajeId])
  @@index([estudioId, actualizadoEn])
}

// ========================================
// INVENTARIO
// ========================================

model Inventario {
  id            Int      @id @default(autoincrement())
  nombre        String
  descripcion   String?
  categoria     String?
  cantidad      Decimal  @db.Decimal(10, 2)
  unidad        String?
  minimo        Decimal? @db.Decimal(10, 2)
  costo         Decimal? @db.Decimal(10, 2)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  eliminadoEn   DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  movimientos MovimientoInventario[]

  @@index([estudioId])
}

// ========================================
// MOVIMIENTOS INVENTARIO
// ========================================

model MovimientoInventario {
  id       Int                      @id @default(autoincrement())
  tipo     TipoMovimientoInventario
  cantidad Decimal                  @db.Decimal(10, 2)

  costoUnitario Decimal? @db.Decimal(10, 2)
  costoTotal    Decimal? @db.Decimal(10, 2)

  motivo   String?
  fecha    DateTime @default(now())

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  inventarioId Int
  inventario   Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)

  tatuajeId String?
  tatuaje   Tatuaje? @relation(fields: [tatuajeId], references: [id], onDelete: SetNull)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estudioId])
  @@index([inventarioId])
  @@index([tatuajeId])
}

// ========================================
// HORARIO DEL ESTUDIO
// ========================================

model HorarioEstudio {
  id        String  @id @default(uuid())
  diaSemana Int
  abierto   Boolean @default(true)
  horaInicio String @default("10:00")
  horaFin    String @default("20:00")

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  eliminadoEn   DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  @@unique([estudioId, diaSemana])
  @@index([estudioId])
}

// ========================================
// BLOQUEOS DE AGENDA
// ========================================

model BloqueoAgenda {
  id        String   @id @default(uuid())
  inicio    DateTime
  fin       DateTime
  motivo    String?
  creadoEn  DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  eliminadoEn   DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([estudioId, inicio])
  @@index([usuarioId])
}

// ========================================
// CONSENTIMIENTO / WAIVER
// ========================================

model Consentimiento {
  id              String   @id @default(uuid())
  textoPlantilla  String
  firmaUrl        String
  firmadoEn       DateTime @default(now())
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt
  eliminadoEn     DateTime?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  citaId String?
  cita   Cita? @relation(fields: [citaId], references: [id], onDelete: SetNull)

  @@index([estudioId])
  @@index([clienteId])
  @@index([estudioId, actualizadoEn])
}

// ========================================
// RECORDATORIOS
// ========================================

model RecordatorioCita {
  id            String              @id @default(uuid())
  canal         CanalRecordatorio   @default(WHATSAPP)
  estado        EstadoRecordatorio  @default(PENDIENTE)
  programadoPara DateTime
  enviadoEn     DateTime?
  mensaje       String
  urlWhatsapp   String?
  creadoEn      DateTime            @default(now())
  actualizadoEn DateTime            @updatedAt

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  citaId String
  cita   Cita @relation(fields: [citaId], references: [id], onDelete: Cascade)

  @@index([estudioId, estado, programadoPara])
  @@index([citaId])
}

// ========================================
// CONFIGURACION DEL ESTUDIO
// ========================================

model ConfiguracionEstudio {
  id Int @id @default(autoincrement())

  estudioId Int @unique

  logoUrl       String?
  nombreMostrar String?
  telefono      String?
  whatsapp      String?
  instagram     String?

  tema           String @default("system")
  colorPrincipal String @default("#D4AF37")
  radio          String @default("medio")

  plantillaConsentimiento String?
  exigirConsentimiento    Boolean @default(true)
  plantillaRecordatorio   String?
  horasAntesRecordatorio  Int     @default(24)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudio Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)
}

// ========================================
// SUSCRIPCION
// ========================================

model Suscripcion {
  id                 Int               @id @default(autoincrement())
  plan               Plan
  estado             EstadoSuscripcion
  iniciaEn           DateTime          @default(now())
  venceEn            DateTime?
  pruebaHasta        DateTime?
  proveedorExternoId String?
  creadoEn           DateTime          @default(now())
  actualizadoEn      DateTime          @updatedAt

  estudioId Int     @unique
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)
}

// ========================================
// ENUMS
// ========================================

enum Rol {
  ADMIN
  TATUADOR
  RECEPCION
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  FINALIZADA
  CANCELADA
}

enum EstadoTatuaje {
  PENDIENTE
  EN_PROCESO
  TERMINADO
  CANCELADO
  PAUSADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum CategoriaGasto {
  MATERIAL
  EQUIPO
  RENTA
  SERVICIOS
  MARKETING
  OTRO
}

enum TipoFoto {
  TATUAJE
  ANTES
  DESPUES
  DISENO
  OTRA
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
  VENCIDA
  PRUEBA
}

enum CanalRecordatorio {
  WHATSAPP
  MANUAL
}

enum EstadoRecordatorio {
  PENDIENTE
  ENVIADO
  CANCELADO
  FALLIDO
}
