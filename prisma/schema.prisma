generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// ESTUDIOS
// ========================================

model Estudio {
  id          Int      @id @default(autoincrement())
  nombre      String
  telefono    String?
  email       String?
  direccion   String?
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarios       Usuario[]
  clientes       Cliente[]
  citas          Cita[]
  tatuajes       Tatuaje[]
  pagos          Pago[]
  gastos         Gasto[]
  inventarios    Inventario[]
  suscripcion    Suscripcion?
}

// ========================================
// USUARIOS
// ========================================

model Usuario {
  id          Int      @id @default(autoincrement())
  nombre      String
  email       String   @unique
  password    String
  rol         Rol      @default(TATUADOR)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudioId   Int
  estudio     Estudio  @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  citas       Cita[]
  tatuajes    Tatuaje[]
  pagos       Pago[]
  gastos      Gasto[]

  @@index([estudioId])
}

// ========================================
// CLIENTES
// ========================================

model Cliente {
  id            Int      @id @default(autoincrement())
  nombre        String
  telefono      String
  email         String?
  instagram     String?
  direccion     String?
  alergias      String?
  enfermedades  String?
  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudioId     Int
  estudio       Estudio  @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  citas         Cita[]
  tatuajes      Tatuaje[]
  pagos         Pago[]
  fotos         Foto[]

  @@index([estudioId])
  @@index([telefono])
  @@unique([estudioId, telefono])
}

// ========================================
// CITAS
// ========================================

model Cita {
  id          Int          @id @default(autoincrement())
  fecha       DateTime
  duracion    Int          @default(120)
  motivo      String?
  notas       String?
  estado      EstadoCita   @default(PENDIENTE)
  creadoEn    DateTime     @default(now())
  actualizadoEn DateTime    @updatedAt

  estudioId   Int
  estudio     Estudio      @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId   Int
  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  usuarioId   Int?
  usuario     Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estudioId, fecha])
  @@index([clienteId])
}

// ========================================
// TATUAJES
// ========================================

model Tatuaje {
  id            Int           @id @default(autoincrement())
  nombre        String
  descripcion   String?
  estilo        String?
  zona          String?
  precio        Decimal?      @db.Decimal(10, 2)
  anticipo      Decimal?      @db.Decimal(10, 2)
  estado        EstadoTatuaje @default(PENDIENTE)
  notas         String?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  estudioId     Int
  estudio       Estudio       @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId     Int
  cliente       Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  usuarioId     Int?
  usuario       Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  fotos         Foto[]
  pagos         Pago[]

  @@index([estudioId])
  @@index([clienteId])
  @@index([usuarioId])
}

// ========================================
// PAGOS
// ========================================

model Pago {
  id          Int      @id @default(autoincrement())
  monto       Decimal  @db.Decimal(10, 2)
  fecha       DateTime @default(now())
  metodo      MetodoPago
  concepto    String?
  notas       String?

  estudioId   Int
  estudio     Estudio  @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tatuajeId   Int?
  tatuaje     Tatuaje? @relation(fields: [tatuajeId], references: [id], onDelete: SetNull)

  usuarioId   Int?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estudioId, fecha])
  @@index([clienteId])
}

// ========================================
// GASTOS
// ========================================

model Gasto {
  id          Int       @id @default(autoincrement())
  concepto    String
  descripcion String?
  monto       Decimal   @db.Decimal(10, 2)
  fecha       DateTime  @default(now())
  categoria   CategoriaGasto
  notas       String?

  estudioId   Int
  estudio     Estudio   @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  usuarioId   Int?
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estudioId, fecha])
}

// ========================================
// INVENTARIO
// ========================================

model Inventario {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  categoria   String?
  cantidad    Decimal  @db.Decimal(10, 2)
  unidad      String?
  minimo      Decimal? @db.Decimal(10, 2)
  costo       Decimal? @db.Decimal(10, 2)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudioId   Int
  estudio     Estudio  @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  @@index([estudioId])
}

// ========================================
// FOTOS
// ========================================

model Foto {
  id          Int      @id @default(autoincrement())
  url         String
  descripcion String?
  tipo        TipoFoto @default(TATUAJE)
  creadoEn    DateTime @default(now())

  estudioId   Int
  clienteId   Int
  tatuajeId   Int?

  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tatuaje     Tatuaje? @relation(fields: [tatuajeId], references: [id], onDelete: Cascade)

  @@index([estudioId])
  @@index([clienteId])
  @@index([tatuajeId])
}

// ========================================
// SUSCRIPCIONES
// ========================================

model Suscripcion {
  id              Int               @id @default(autoincrement())
  plan            Plan
  estado          EstadoSuscripcion @default(ACTIVA)
  inicio          DateTime          @default(now())
  renovacion      DateTime?
  proveedor       String?
  proveedorId     String?
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt

  estudioId       Int               @unique
  estudio         Estudio           @relation(fields: [estudioId], references: [id], onDelete: Cascade)
}

// ========================================
// ENUMS
// ========================================

enum Rol {
  ADMIN
  TATUADOR
  RECEPCION
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  FINALIZADA
  CANCELADA
}

enum EstadoTatuaje {
  PENDIENTE
  EN_PROCESO
  PAUSADO
  TERMINADO
  CANCELADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum CategoriaGasto {
  MATERIAL
  EQUIPO
  RENTA
  SERVICIOS
  MARKETING
  OTRO
}

enum TipoFoto {
  TATUAJE
  ANTES
  DESPUES
  DISENO
  OTRA
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
  VENCIDA
  PRUEBA
}
