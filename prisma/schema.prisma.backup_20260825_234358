generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// ESTUDIOS
// ========================================

model Estudio {
  id            Int      @id @default(autoincrement())
  nombre        String
  telefono      String?
  email         String?
  direccion     String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarios              Usuario[]
  clientes              Cliente[]
  citas                 Cita[]
  tatuajes              Tatuaje[]
  pagos                 Pago[]
  gastos                Gasto[]
  inventarios           Inventario[]
  movimientosInventario MovimientoInventario[]
  suscripcion           Suscripcion?
  configuracion         ConfiguracionEstudio?
}

// ========================================
// USUARIOS
// ========================================

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  email         String   @unique
  password      String
  rol           Rol      @default(TATUADOR)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  citas                 Cita[]
  tatuajes              Tatuaje[]
  pagos                 Pago[]
  gastos                Gasto[]
  movimientosInventario MovimientoInventario[]

  @@index([estudioId])
}

// ========================================
// CLIENTES
// ========================================

model Cliente {
  id            Int      @id @default(autoincrement())
  nombre        String
  telefono      String
  email         String?
  instagram     String?
  direccion     String?
  alergias      String?
  enfermedades  String?
  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  citas    Cita[]
  tatuajes Tatuaje[]
  pagos    Pago[]
  fotos    Foto[]

  @@unique([estudioId, telefono])
  @@index([estudioId])
  @@index([telefono])
}

// ========================================
// CITAS
// ========================================

model Cita {
  id            Int        @id @default(autoincrement())
  fecha         DateTime
  duracion      Int        @default(120)
  motivo        String?
  notas         String?
  estado        EstadoCita @default(PENDIENTE)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estudioId, fecha])
  @@index([clienteId])
}

// ========================================
// TATUAJES
// ========================================

model Tatuaje {
  id            Int           @id @default(autoincrement())
  nombre        String
  descripcion   String?
  estilo        String?
  zona          String?
  precio        Decimal?      @db.Decimal(10, 2)
  anticipo      Decimal?      @db.Decimal(10, 2)
  estado        EstadoTatuaje @default(PENDIENTE)
  notas         String?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  fotos Foto[]
  pagos Pago[]

  @@index([estudioId])
  @@index([clienteId])
  @@index([usuarioId])
}

// ========================================
// PAGOS
// ========================================

model Pago {
  id       Int        @id @default(autoincrement())
  monto    Decimal    @db.Decimal(10, 2)
  concepto String?
  notas    String?
  metodo   MetodoPago
  fecha    DateTime   @default(now())

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tatuajeId Int?
  tatuaje   Tatuaje? @relation(fields: [tatuajeId], references: [id], onDelete: Cascade)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estudioId])
}

// ========================================
// GASTOS
// ========================================

model Gasto {
  id          Int            @id @default(autoincrement())
  concepto    String
  descripcion String?
  monto       Decimal        @db.Decimal(10, 2)
  fecha       DateTime       @default(now())
  categoria   CategoriaGasto
  notas       String?

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estudioId, fecha])
}

// ========================================
// FOTOS
// ========================================

model Foto {
  id          Int      @id @default(autoincrement())
  url         String
  descripcion String?
  tipo        TipoFoto @default(TATUAJE)
  creadoEn    DateTime @default(now())

  estudioId Int
  clienteId Int
  tatuajeId Int?

  cliente Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tatuaje Tatuaje? @relation(fields: [tatuajeId], references: [id], onDelete: Cascade)

  @@index([estudioId])
  @@index([clienteId])
  @@index([tatuajeId])
}

// ========================================
// INVENTARIO
// ========================================

model Inventario {
  id            Int      @id @default(autoincrement())
  nombre        String
  descripcion   String?
  categoria     String?
  cantidad      Decimal  @db.Decimal(10, 2)
  unidad        String?
  minimo        Decimal? @db.Decimal(10, 2)
  costo         Decimal? @db.Decimal(10, 2)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  movimientos MovimientoInventario[]

  @@index([estudioId])
}

// ========================================
// MOVIMIENTOS INVENTARIO
// ========================================

model MovimientoInventario {
  id       Int                      @id @default(autoincrement())
  tipo     TipoMovimientoInventario
  cantidad Decimal                  @db.Decimal(10, 2)
  motivo   String?
  fecha    DateTime                 @default(now())

  estudioId Int
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  inventarioId Int
  inventario   Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estudioId])
  @@index([inventarioId])
}

// ========================================
// CONFIGURACION DEL ESTUDIO
// ========================================

model ConfiguracionEstudio {
  id Int @id @default(autoincrement())

  estudioId Int @unique

  logoUrl       String?
  nombreMostrar String?
  telefono      String?
  whatsapp      String?
  instagram     String?

  tema           String @default("dark")
  colorPrincipal String @default("#D4AF37")

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudio Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)
}

// ========================================
// SUSCRIPCION
// ========================================

model Suscripcion {
  id       Int               @id @default(autoincrement())
  plan     Plan
  estado   EstadoSuscripcion
  creadoEn DateTime          @default(now())

  estudioId Int     @unique
  estudio   Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)
}

// ========================================
// ENUMS
// ========================================

enum Rol {
  ADMIN
  TATUADOR
  RECEPCION
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  FINALIZADA
  CANCELADA
}

enum EstadoTatuaje {
  PENDIENTE
  EN_PROCESO
  TERMINADO
  CANCELADO
  PAUSADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum CategoriaGasto {
  MATERIAL
  EQUIPO
  RENTA
  SERVICIOS
  MARKETING
  OTRO
}

enum TipoFoto {
  TATUAJE
  ANTES
  DESPUES
  DISENO
  OTRA
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
  VENCIDA
  PRUEBA
}
